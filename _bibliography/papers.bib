@inproceedings{10.1145/3745778.3766666,
  author = {Chang, Zekun and Gao, Yixuan and Noma, Yuta and Feng, Shuo and Yang, Xinyi and Shinoda, Kazuhiro and Ta, Tung and Yatani, Koji and Yokota, Tomoyuki and Someya, Takao and Tachi, Tomohiro and Kawahara, Yoshihiro and Narumi, Koya and Guimbretiere, Francois and Roumen, Thijs},
  title = {OriStitch: A Machine Embroidery Workflow to Turn Existing Fabrics into Self-Folding 3D Textiles},
  year = {2025},
  isbn = {9798400720345},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3745778.3766666},
  doi = {10.1145/3745778.3766666},
  abstract = {OriStitch is a computational fabrication workflow to turn existing flat fabrics into self-folding 3D structures. It uses machine embroidering of functional threads in specific patterns on fabrics, users then apply heat to deform the structure into a target 3D structure. OriStitch is compatible with a range of existing materials (e.g., leather, woven fabric, and denim).We present the design of specific embroidered hinges that fully close under exposure to heat. We discuss the stitch pattern design, thread and fabric selection, and heating conditions. To allow users to create 3D textiles using our hinges, we create a tool to convert 3D meshes to 2D stitch patterns automatically, as well as an end-to-end fabrication and actuation workflow. To validate this workflow, we designed and fabricated a range of application models consisting of up to 338 hinges each (the cap of Figure 1, a handbag, and a vase cover).In technical evaluation, we found that our tool successfully converted 26/28 models found in related papers. We also demonstrate the folding performance across different materials (suede leather, cork, Neoprene, and felt).},
  booktitle = {Proceedings of the ACM Symposium on Computational Fabrication},
  articleno = {21},
  numpages = {14},
  keywords = {Digital Fabrication, Machine Embroidery, Self-folding, Origami/Kirigami},
  location = {},
  series = {SCF '25},
  abbr = {SCF '25},
  html = {https://doi.org/10.1145/3745778.3766666},
  preview = {Oristitch.png},
  note = {Media Coverage: <a href="https://news.cornell.edu/stories/2025/12/seamless-tech-oristitch-threads-computation-and-3d-textiles" target="_blank">Cornell Chronicle</a>},
  bibtex_show = {true},
  selected = {true}
}



